# Public origin of the app; required by adapter-node for CSRF checks
ORIGIN="http://localhost:3000"

# Directory holding data.db and files/
DATA_DIR="./.onecrab"

# adapter-node rejects request bodies above this; must exceed the 5 MB upload cap
BODY_SIZE_LIMIT="6M"

# Behind a reverse proxy, read the client IP (used by the Guess Limit) from this header
# ADDRESS_HEADER="X-Forwarded-For"
# Number of trusted proxies appending to X-Forwarded-For
# XFF_DEPTH="1"
